+//! `zola plan`: everything `zola build` would write, without writing it.
+//!
+//! A build tool that wraps zola can turn each planned file into a product of
+//! its own — with its own inputs and its own cache entry — instead of
+//! treating the output directory as one opaque blob. For that it needs two
+//! things from zola up front: the full list of output files, and for each
+//! one the input files whose content determines it. This module answers both
+//! from the loaded `Site`, by the same code paths the build uses to decide
+//! where things go (`Queue`, `sass`, the search index, the static copy), so
+//! the plan and the build cannot drift apart.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::{Path, PathBuf};
+
+use walkdir::WalkDir;
+
+use crate::Site;
+use crate::queue::Queue;
+use config::IndexFormat;
+use errors::Result;
+
+/// One file the build will produce.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PlannedOutput {
+    /// Relative to the output directory.
+    pub path: PathBuf,
+    /// Absolute paths of the files whose content can change this output.
+    pub sources: Vec<PathBuf>,
+}
+
+impl PlannedOutput {
+    pub fn new(path: PathBuf, sources: Vec<PathBuf>) -> Self {
+        let path = path.strip_prefix("/").map(Path::to_path_buf).unwrap_or(path);
+        Self { path, sources }
+    }
+}
+
+/// Regular files under `dir`, following symlinks as the build's walkers do.
+/// A missing directory is simply empty.
+fn files_under(dir: &Path) -> Vec<PathBuf> {
+    WalkDir::new(dir)
+        .follow_links(true)
+        .into_iter()
+        .filter_map(|e| e.ok())
+        .filter(|e| e.path().is_file())
+        .map(|e| e.into_path())
+        .collect()
+}
+
+impl Site {
+    /// Inputs every rendered output depends on: the config file and every
+    /// template of the site and its theme. Listing the whole template tree
+    /// rather than the exact `extends`/`include` chain is deliberate: it is
+    /// always correct, and zola rebuilds the whole site on any change anyway,
+    /// so precision here would change what a wrapper reports as dirty, not
+    /// how often zola runs.
+    fn common_sources(&self) -> Vec<PathBuf> {
+        let mut sources = vec![self.config_path.clone()];
+        sources.extend(files_under(&self.templates_path));
+        if let Some(ref theme) = self.config.theme {
+            sources.extend(files_under(
+                &self.base_path.join("themes").join(theme).join("templates"),
+            ));
+        }
+        sources
+    }
+
+    /// Static files as `copy_static_directories` lays them out: theme files
+    /// first, then the site's own, which overwrite them. Processed images are
+    /// skipped — they are enumerated from the image queue, not from whatever
+    /// a previous build left in `static/processed_images/`.
+    fn plan_static(&self, outputs: &mut Vec<PlannedOutput>) {
+        let processed = self.static_path.join(imageproc::RESIZED_SUBDIR);
+        let mut roots = Vec::new();
+        if let Some(ref theme) = self.config.theme {
+            roots.push((self.base_path.join("themes").join(theme).join("static"), None));
+        }
+        roots.push((self.static_path.clone(), self.config.ignored_static_globset.as_ref()));
+        for (root, ignore) in roots {
+            for file in files_under(&root) {
+                if file.starts_with(&processed) {
+                    continue;
+                }
+                let relative = file.strip_prefix(&root).unwrap().to_path_buf();
+                if let Some(gs) = ignore
+                    && gs.is_match(&relative)
+                {
+                    continue;
+                }
+                outputs.push(PlannedOutput::new(relative, vec![file]));
+            }
+        }
+    }
+
+    /// Every non-partial `.sass`/`.scss` compiles to a `.css` at the same
+    /// relative path (see `sass::compile_sass`). Partials are reachable from
+    /// any of them, so each stylesheet depends on the whole `sass/` tree.
+    fn plan_sass(&self, outputs: &mut Vec<PlannedOutput>) {
+        let mut roots = Vec::new();
+        if let Some(ref theme) = self.config.theme {
+            let theme_path = self.base_path.join("themes").join(theme);
+            if theme_path.join("sass").exists() {
+                roots.push(theme_path);
+            }
+        }
+        if self.config.compile_sass {
+            roots.push(self.base_path.clone());
+        }
+        for root in roots {
+            let sass_path = root.join("sass");
+            let all = files_under(&sass_path);
+            for file in crate::sass::get_non_partial_scss(&sass_path) {
+                let path = file.strip_prefix(&sass_path).unwrap().with_extension("css");
+                outputs.push(PlannedOutput::new(path, all.clone()));
+            }
+        }
+    }
+
+    /// Search indexes as `build_search_index` writes them.
+    fn plan_search_index(&self, outputs: &mut Vec<PlannedOutput>) {
+        if !self.config.needs_search_index() {
+            return;
+        }
+        let mut langs = Vec::new();
+        if self.config.build_search_index {
+            langs.push(self.config.default_language.clone());
+        }
+        for (code, language) in &self.config.other_languages() {
+            if *code != self.config.default_language && language.build_search_index {
+                langs.push((*code).to_string());
+            }
+        }
+        for lang in langs {
+            let sources: Vec<PathBuf> = self
+                .library
+                .pages
+                .values()
+                .filter(|p| p.lang == lang)
+                .map(|p| p.file.path.clone())
+                .collect();
+            let path = PathBuf::from(self.config.search.index_format.filename(&lang));
+            outputs.push(PlannedOutput::new(path, sources));
+        }
+        match self.config.search.index_format {
+            IndexFormat::ElasticlunrJavascript | IndexFormat::ElasticlunrJson => {
+                outputs.push(PlannedOutput::new(PathBuf::from("elasticlunr.min.js"), Vec::new()));
+            }
+            _ => {}
+        }
+    }
+
+    /// Syntax-highlighting theme stylesheets (`render_themes_css`).
+    fn plan_themes_css(&self, outputs: &mut Vec<PlannedOutput>) {
+        let themes = self
+            .config
+            .markdown
+            .highlighting
+            .as_ref()
+            .map(|x| x.generate_themes_css())
+            .unwrap_or_default();
+        for (filename, _) in themes {
+            outputs.push(PlannedOutput::new(PathBuf::from(filename), Vec::new()));
+        }
+    }
+
+    /// Images enqueued while rendering markdown, which the build writes to
+    /// `static/processed_images/` and then copies out with the static tree.
+    /// An image resized from a template is enqueued only while that template
+    /// renders, so it cannot appear here; a wrapper's plan-vs-build check
+    /// will report it, which is the honest answer until templates are
+    /// rendered at plan time.
+    fn plan_images(&self, outputs: &mut Vec<PlannedOutput>) {
+        for (input, output) in self.planned_image_ops() {
+            let relative = output.strip_prefix(&self.static_path).unwrap().to_path_buf();
+            outputs.push(PlannedOutput::new(relative, vec![input]));
+        }
+    }
+
+    /// The complete build plan, sorted by output path, each output listing
+    /// every input that can change it. The site must be loaded.
+    pub fn plan(&self) -> Result<Vec<PlannedOutput>> {
+        let common = self.common_sources();
+        let mut outputs = Vec::new();
+
+        self.plan_sass(&mut outputs);
+        self.plan_search_index(&mut outputs);
+        self.plan_themes_css(&mut outputs);
+        self.plan_images(&mut outputs);
+        self.plan_static(&mut outputs);
+
+        let queue = Queue::full_build(self);
+        let rendered_from = outputs.len();
+        outputs.extend(queue.plan());
+        // Everything the queue renders goes through the templates and reads
+        // the config; copied assets do not, but a few extra inputs on a
+        // copied file are harmless where a missing one would be a stale page.
+        for output in &mut outputs[rendered_from..] {
+            output.sources.extend(common.iter().cloned());
+        }
+        // Aliases: the queue only knows the redirect's URL; the content file
+        // that declares it is what the stub depends on.
+        let mut alias_owner: BTreeMap<PathBuf, PathBuf> = BTreeMap::new();
+        for page in self.library.pages.values() {
+            for alias in &page.meta.aliases {
+                alias_owner.insert(alias_path(alias), page.file.path.clone());
+            }
+        }
+        for section in self.library.sections.values() {
+            for alias in &section.meta.aliases {
+                alias_owner.insert(alias_path(alias), section.file.path.clone());
+            }
+        }
+        for output in &mut outputs {
+            if let Some(owner) = alias_owner.get(&output.path) {
+                output.sources.push(owner.clone());
+            }
+        }
+
+        // Two jobs can name the same file (an alias pointing at an existing
+        // page, a static file shadowing a theme's); the build writes it twice
+        // and the last write wins. The plan lists it once with the union of
+        // its inputs, which is what a change to either would do to it.
+        let mut merged: BTreeMap<PathBuf, BTreeSet<PathBuf>> = BTreeMap::new();
+        for output in outputs {
+            merged.entry(output.path).or_default().extend(output.sources);
+        }
+        Ok(merged
+            .into_iter()
+            .map(|(path, sources)| PlannedOutput { path, sources: sources.into_iter().collect() })
+            .collect())
+    }
+}
+
+/// Where `Queue::render_alias` writes the redirect stub for `from`.
+fn alias_path(from: &str) -> PathBuf {
+    let mut path = PathBuf::from(from);
+    if !from.ends_with(".html") {
+        path.push("index.html");
+    }
+    PlannedOutput::new(path, Vec::new()).path
+}
