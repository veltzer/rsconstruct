@@ -0,0 +1,68 @@
+use std::path::{Path, PathBuf};
+
+use errors::{Context, Result, bail};
+use serde_json::json;
+use site::Site;
+
+/// Schema version of the manifest printed by `zola plan`.
+const MANIFEST_VERSION: u32 = 1;
+
+/// Express `path` relative to `cwd`. A relative path is already that (the
+/// user passed `--output-dir _site`); an absolute one is rewritten, and one
+/// outside the current directory is an error because a consumer would have
+/// no way to refer to it.
+fn relative_to(cwd: &Path, path: &Path) -> Result<PathBuf> {
+    if path.is_relative() {
+        return Ok(path.to_path_buf());
+    }
+    match path.strip_prefix(cwd) {
+        Ok(rel) => Ok(rel.to_path_buf()),
+        Err(_) => bail!(
+            "{} is outside the current directory {}; run `zola plan` from the project root",
+            path.display(),
+            cwd.display()
+        ),
+    }
+}
+
+pub fn plan(
+    root_dir: &Path,
+    config_file: &Path,
+    base_url: Option<&str>,
+    output_dir: Option<&Path>,
+    include_drafts: bool,
+) -> Result<()> {
+    let mut site = Site::new(root_dir, config_file)?;
+    if let Some(output_dir) = output_dir {
+        site.set_output_path(output_dir);
+    }
+    if let Some(b) = base_url {
+        site.set_base_url(b.to_string());
+    }
+    if include_drafts {
+        site.include_drafts();
+    }
+    site.load()?;
+
+    let cwd = std::env::current_dir()
+        .and_then(|d| d.canonicalize())
+        .context("Could not determine the current directory")?;
+    let output_root = relative_to(&cwd, &site.output_path)?;
+
+    let mut outputs = Vec::new();
+    for planned in site.plan()? {
+        let mut sources = Vec::with_capacity(planned.sources.len());
+        for source in &planned.sources {
+            sources.push(relative_to(&cwd, source)?.display().to_string());
+        }
+        outputs.push(json!({
+            "path": output_root.join(&planned.path).display().to_string(),
+            "sources": sources,
+        }));
+    }
+
+    let manifest = json!({ "version": MANIFEST_VERSION, "outputs": outputs });
+    let json = serde_json::to_string_pretty(&manifest).context("Could not serialize the plan")?;
+    println!("{json}");
+    Ok(())
+}
